{
    "name": "trello-clone",
    "version": "1.0.0",
    "private": true,
    "description": "Bacheca Kanban collaborativa in tempo reale (React, Express, Socket.IO, MySQL)",
    "license": "MIT",
    "author": "Alexandru Mihai Dimofte",
    "workspaces": [
        "app/server",
        "app/client"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "dev": "concurrently -n server,client -c blue,magenta \"npm run dev -w app/server\" \"npm run dev -w app/client\"",
        "build": "npm run build -w app/client",
        "start": "npm start -w app/server",
        "lint": "eslint .",
        "format": "prettier --write \"**/*.{js,jsx,cjs,mjs,json,css,html,yml}\"",
        "format:check": "prettier --check \"**/*.{js,jsx,cjs,mjs,json,css,html,yml}\"",
        "test": "npm test -w app/server"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "concurrently": "^9.2.1",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "globals": "^17.14.0",
        "prettier": "^3.10.1"
    }
}
