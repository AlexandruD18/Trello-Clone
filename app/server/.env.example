# Copia questo file in app/server/.env e compila i valori.

# Porta HTTP del server (API, Socket.IO e, in produzione, il client compilato)
PORT=3000

# Segreto per firmare i token di sessione. Obbligatorio, almeno 32 caratteri.
# Generalo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Database MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=trello
DB_USER=trello
DB_PASSWORD=

# Tentativi di login/registrazione consentiti per IP ogni 15 minuti (predefinito 20)
AUTH_RATE_LIMIT=20
