{
    "name": "trello-clone-server",
    "version": "1.0.0",
    "description": "API REST e Socket.IO di Trello Clone",
    "main": "src/index.js",
    "scripts": {
        "dev": "node --watch src/index.js",
        "start": "node src/index.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "db:migrate": "node src/db/migrazioni.js up",
        "db:migrate:undo": "node src/db/migrazioni.js down",
        "db:pending": "node src/db/migrazioni.js pending"
    },
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.5",
        "dotenv": "^18.0.10",
        "express": "^4.18.2",
        "express-rate-limit": "^8.7.5",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.2",
        "mysql2": "^3.6.5",
        "sequelize": "^6.35.2",
        "socket.io": "^4.7.2",
        "umzug": "^3.8.3"
    },
    "devDependencies": {
        "supertest": "^7.3.2",
        "vitest": "^5.1.1"
    }
}
